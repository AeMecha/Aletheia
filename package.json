{
  "name": "aletheia-desktop",
  "productName": "Aletheia",
  "version": "0.1.2",
  "description": "A local personal knowledge library with its own Qwen model engine.",
  "author": "Aletheia contributors",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "src/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "prepare:assets": "node scripts/prepare-assets.js",
    "build": "node scripts/build.js",
    "build:dir": "node scripts/build.js --dir",
    "smoke": "node scripts/smoke.js",
    "build:linux": "node scripts/build.js --platform linux",
    "build:linux:dir": "node scripts/build.js --platform linux --dir"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "tar-stream": "3.2.2"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/AeMecha/Aletheia.git"
  },
  "bugs": {
    "url": "https://github.com/AeMecha/Aletheia/issues"
  },
  "homepage": "https://github.com/AeMecha/Aletheia#readme"
}
