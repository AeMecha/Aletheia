{
  "name": "aletheia-scriptorium",
  "productName": "Aletheia Scriptorium",
  "version": "0.2.1",
  "description": "A personal knowledge library with local GGUF models and configurable AI API connections.",
  "author": "Aletheia contributors",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "module",
  "main": "src/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "prepare:assets": "node scripts/prepare-assets.js",
    "build": "node scripts/build.js",
    "build:dir": "node scripts/build.js --dir",
    "smoke": "node scripts/smoke.js",
    "build:linux": "node scripts/build.js --platform linux",
    "build:linux:dir": "node scripts/build.js --platform linux --dir"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "tar-stream": "3.2.2"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/AeMecha/Aletheia-Scriptorium.git"
  },
  "bugs": {
    "url": "https://github.com/AeMecha/Aletheia-Scriptorium/issues"
  },
  "homepage": "https://github.com/AeMecha/Aletheia-Scriptorium#readme"
}
